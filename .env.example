# Finance API Configuration

# Database Connection - Option 1: Individual components (preferred)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Database Connection - Option 2: Complete URL (overrides individual settings)
# DATABASE_URL=postgresql://user:password@localhost:5432/finance_db

# Connection Pool Settings (optional, defaults shown)
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Database Debug Mode (logs connection events)
DB_DEBUG=false

# Server configuration
PORT=8081
DEBUG=false

# Application settings
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-in-production

# Wise API integration
WISE_API_KEY=your-wise-api-key-here
